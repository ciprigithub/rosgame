<?xml version="1.0"?>
<package format="3">
  <name>team_xx</name>
  <version>1.0.0</version>
  <description>Python starter package for CyPR Team Project</description>
  <maintainer email="jgmonroy@uma.es">CyPR - University of Malaga</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgame_bridge</exec_depend>
  <exec_depend>rosgame_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
